<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FengBroPlayer.ViewModels"
        xmlns:models="using:FengBroPlayer.Models"
        xmlns:conv="using:FengBroPlayer.Converters"
        xmlns:ctrl="using:FengBroPlayer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="FengBroPlayer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="560"
        Background="{StaticResource BgAppBrush}"
        WindowStartupLocation="CenterScreen"
        PointerMoved="OnWindowPointerMoved"
        DragDrop.AllowDrop="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.playlist-row.current">
            <Setter Property="Background" Value="{StaticResource BgSelectedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <!-- =====================================================================
         Layout (PotPlayer-inspired):
           Row 0  Top chrome bar  (app name ▼ · format tag · filename · win ctrls)
           Row 1  Menu (檔案 / 播放 / 檢視)
           Row 2  Stage + Playlist dock
           Row 3  Info bar          (big time · filename · codec · VU meter)
           Row 4  Yellow seek bar
           Row 5  Compact transport (stop · prev · play · next · ±10s · playlist · fullscreen · open · vol)
           Row 6  Status bar
         ===================================================================== -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <!-- ===================== TOP CHROME BAR (PotPlayer-style) ===================== -->
        <Border Grid.Row="0" Classes="chrome-top">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                <!-- App name + dropdown indicator (left-click opens the menu, like PotPlayer) -->
                <Button Grid.Column="0"
                        x:Name="ChromeAppButton"
                        Classes="chrome-app"
                        Content="FengBroPlayer ▼"
                        Click="OnChromeAppMenuClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="開啟檔案…"
                                      Command="{Binding OpenMediaCommand}"
                                      InputGesture="Ctrl+O" />
                            <MenuItem Header="開啟網路串流…"
                                      Command="{Binding OpenNetworkUrlCommand}" />
                            <Separator />
                            <MenuItem Header="播放/暫停"
                                      Command="{Binding TogglePlayCommand}"
                                      InputGesture="Space" />
                            <MenuItem Header="停止"
                                      Command="{Binding StopMediaCommand}"
                                      InputGesture="S" />
                            <Separator />
                            <MenuItem Header="播放清單"
                                      Command="{Binding TogglePlaylistCommand}"
                                      InputGesture="P" />
                            <MenuItem Header="全螢幕"
                                      Command="{Binding ToggleFullscreenCommand}"
                                      InputGesture="F" />
                            <Separator />
                            <MenuItem Header="結束" Click="OnChromeExitClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Format tag chip -->
                <Border Grid.Column="1" Classes="format-tag">
                    <TextBlock Text="{Binding FormatTag}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <!-- Filename (truncated) -->
                <TextBlock Grid.Column="2"
                           Classes="chrome-filename"
                           Text="{Binding CurrentMedia.Title, FallbackValue='尚未載入媒體'}" />

                <!-- Right-side window controls -->
                <Button Grid.Column="3"
                        Classes="chrome-icon"
                        Content="📌"
                        ToolTip.Tip="釘選置頂"
                        Click="OnTogglePinClick" />
                <Button Grid.Column="4"
                        Classes="chrome-icon"
                        Content="─"
                        ToolTip.Tip="最小化"
                        Click="OnMinimizeClick" />
                <Button Grid.Column="5"
                        Classes="chrome-icon"
                        Content="☐"
                        ToolTip.Tip="最大化"
                        Click="OnMaximizeClick" />
                <Button Grid.Column="6"
                        Classes="chrome-icon"
                        Content="✕"
                        ToolTip.Tip="關閉"
                        Click="OnCloseClick" />
                <Border Grid.Column="7" Width="0" />
            </Grid>
        </Border>

        <!-- ===================== MENU ===================== -->
        <Menu Grid.Row="1"
              IsVisible="{Binding IsMenuBarVisible}"
              Background="{StaticResource BgPanelBrush}">
            <MenuItem Header="檔案(_F)">
                <MenuItem Header="開啟檔案…"
                          Command="{Binding OpenMediaCommand}"
                          InputGesture="Ctrl+O" />
                <MenuItem Header="開啟資料夾…"
                          Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="開啟音樂…"
                          Command="{Binding OpenMusicCommand}" />
                <MenuItem Header="開啟影片…"
                          Command="{Binding OpenVideoCommand}" />
                <MenuItem Header="開啟網路串流…"
                          Command="{Binding OpenNetworkUrlCommand}" />
                <Separator />
                <MenuItem Header="開啟字幕…"
                          Command="{Binding OpenSubtitleCommand}"
                          IsEnabled="{Binding IsVideoStage}" />
                <MenuItem Header="關閉字幕"
                          Command="{Binding ClearSubtitleCommand}"
                          IsEnabled="{Binding HasSubtitle}" />
                <MenuItem Header="Load dynamic lyrics (.lrc)"
                          Command="{Binding OpenLyricsCommand}" />
                <MenuItem Header="Hide dynamic lyrics"
                          Command="{Binding ClearLyricsCommand}"
                          IsEnabled="{Binding HasLyrics}" />
                <Separator />
                <MenuItem Header="最近播放"
                          Command="{Binding ShowRecentDockCommand}" />
                <MenuItem Header="最近網路串流"
                          Command="{Binding ShowStreamDockCommand}" />
                <MenuItem Header="清除最近播放"
                          Command="{Binding ClearRecentCommand}" />
                <MenuItem Header="清除最近網路串流"
                          Command="{Binding ClearRecentStreamsCommand}" />
                <Separator />
                <MenuItem Header="結束"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="播放(_P)">
                <MenuItem Header="播放/暫停"
                          Command="{Binding TogglePlayCommand}"
                          InputGesture="Space" />
                <MenuItem Header="停止"
                          Command="{Binding StopMediaCommand}"
                          InputGesture="S" />
                <MenuItem Header="上一首/上一部"
                          Command="{Binding PlayPreviousCommand}" />
                <MenuItem Header="下一首/下一部"
                          Command="{Binding PlayNextCommand}" />
                <Separator />
                <MenuItem Header="靜音"
                          Command="{Binding ToggleMuteCommand}"
                          InputGesture="M" />
            </MenuItem>
            <MenuItem Header="檢視(_V)">
                <MenuItem Header="播放清單"
                          Command="{Binding TogglePlaylistCommand}"
                          InputGesture="P" />
                <MenuItem Header="全螢幕"
                          Command="{Binding ToggleFullscreenCommand}"
                          InputGesture="F" />
                <MenuItem Header="影片資訊"
                          Command="{Binding ToggleMediaInfoCommand}"
                          InputGesture="Tab" />
            </MenuItem>
        </Menu>

        <!-- ===================== STAGE + PLAYLIST ===================== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">

            <!-- Stage: video HWND is only visible in video mode.
                 HWND airspace paints above Avalonia siblings — keeping it under audio
                 made the stage look solid white when playing mp3. Host is recreated
                 when returning to video (Destroy only pauses, does not Stop). -->
            <Grid x:Name="StageRoot"
                  Grid.Column="0"
                  Background="{StaticResource BgStageBrush}">

                <!-- Video surface: visible only for video (avoids white HWND over audio UI) -->
                <Border Background="#000000"
                        ClipToBounds="True"
                        IsVisible="{Binding IsVideoStage}"
                        ZIndex="0">
                    <ctrl:EmbeddedVideoView x:Name="VideoHost"
                                            MediaPlayer="{Binding VideoMediaPlayer}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
                </Border>

                <!-- Tab toggles this compact overlay without interrupting playback. -->
                <Border IsVisible="{Binding IsMediaInfoVisible}"
                        ZIndex="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="18"
                        MaxWidth="440"
                        Padding="14,12"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="#E6171717"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <StackPanel Spacing="5">
                        <TextBlock Text="影片資訊" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding CurrentMedia.Title, FallbackValue='尚未載入影片'}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentMedia.Subtitle}"
                                   Classes="subtitle"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusDetail}"
                                   Classes="muted"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PositionText}"
                                   Classes="muted" />
                        <TextBlock Text="{Binding DurationText}"
                                   Classes="muted" />
                        <TextBlock Text="{Binding CurrentMedia.SourceUrl, FallbackValue='本機媒體檔'}"
                                   Classes="muted"
                                   MaxWidth="410"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Audio / idle stage -->
                <Border Background="{StaticResource BgStageBrush}"
                        IsVisible="{Binding IsAudioStage}"
                        ZIndex="1"
                        PointerPressed="OnAudioStagePointerPressed"
                        PointerWheelChanged="OnAudioStageWheel"
                        DoubleTapped="OnAudioStageDoubleTapped"
                        Cursor="Hand">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="開啟檔案…" Command="{Binding OpenMediaCommand}" />
                            <MenuItem Header="播放/暫停" Command="{Binding TogglePlayCommand}" />
                            <MenuItem Header="停止" Command="{Binding StopMediaCommand}" />
                            <Separator />
                            <MenuItem Header="播放清單" Command="{Binding TogglePlaylistCommand}" />
                            <MenuItem Header="全螢幕" Command="{Binding ToggleFullscreenCommand}" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <!-- Empty / audio cover -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="16"
                                    MaxWidth="480">
                            <Border Width="200" Height="200"
                                    CornerRadius="12"
                                    BoxShadow="0 12 32 0 #40000000"
                                    ClipToBounds="True"
                                    IsVisible="{Binding CurrentMedia, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Background="{Binding CurrentMedia.CoverHue, Converter={x:Static conv:HueToBrushConverter.Instance}}">
                                <Panel>
                                    <!-- Placeholder when no real album art (never a blank white plate) -->
                                    <StackPanel Spacing="6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !HasCurrentCoverImage}">
                                        <TextBlock Text="♪"
                                                   Foreground="White"
                                                   FontSize="48"
                                                   FontWeight="Bold"
                                                   Opacity="0.9"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="無封面"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   Opacity="0.55"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <!-- Real embedded / sidecar cover only -->
                                    <Image Source="{Binding CurrentCoverImage}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           IsVisible="{Binding HasCurrentCoverImage}" />
                                </Panel>
                            </Border>

                            <TextBlock Text="{Binding CurrentMedia.Title, FallbackValue='鋒兄播放器'}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding CurrentMedia.Subtitle, FallbackValue='開啟檔案或拖放媒體到視窗'}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" />

                            <ctrl:LyricTextBlock Text="{Binding CurrentLyricText}"
                                                 IsVisible="{Binding HasLyrics}"
                                                 MaxWidth="560"
                                                 Margin="0,10,0,0"
                                                 FontSize="18"
                                                 FontWeight="SemiBold"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 HorizontalAlignment="Center"
                                                 TextWrapping="Wrap"
                                                 TextTrimming="None"
                                                 TextAlignment="Center" />

                            <!-- Mini waveform when audio -->
                            <Border Height="36"
                                    Margin="0,8,0,0"
                                    IsVisible="{Binding IsAudioStage}"
                                    HorizontalAlignment="Center"
                                    MinWidth="200">
                                <ItemsControl ItemsSource="{Binding WaveformBars}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:Double">
                                            <Border Width="3"
                                                    Height="{Binding Converter={x:Static conv:WaveHeightConverter.Instance}}"
                                                    CornerRadius="1"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource WaveformGradient}"
                                                    Opacity="0.8" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding CurrentMedia, Converter={x:Static ObjectConverters.IsNull}}">
                                <Button Classes="chip" Command="{Binding OpenMediaCommand}" Content="開啟檔案" />
                                <Button Classes="chip" Command="{Binding OpenFolderCommand}" Content="開啟資料夾" />
                                <Button Classes="chip" Command="{Binding OpenNetworkUrlCommand}" Content="開啟網路串流" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Playlist / Recent dock -->
            <Border Grid.Column="1"
                    Width="300"
                    IsVisible="{Binding IsPlaylistVisible}"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Tabs: 播放清單 | 最近 | 串流 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="8,10,8,4"
                                Spacing="4">
                        <Button Classes="dock-tab"
                                Classes.active="{Binding IsPlaylistDock}"
                                Content="清單"
                                Command="{Binding ShowPlaylistDockCommand}"
                                ToolTip.Tip="播放清單" />
                        <Button Classes="dock-tab"
                                Classes.active="{Binding IsRecentDock}"
                                Content="最近"
                                Command="{Binding ShowRecentDockCommand}"
                                ToolTip.Tip="最近播放（本機+網路）" />
                        <Button Classes="dock-tab"
                                Classes.active="{Binding IsStreamDock}"
                                Content="串流"
                                Command="{Binding ShowStreamDockCommand}"
                                ToolTip.Tip="最近網路串流" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          Margin="12,4,8,8"
                          ColumnSpacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsPlaylistDock}">
                            <TextBlock Text="自動播放"
                                       Classes="muted"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Classes="autoplay"
                                          IsChecked="{Binding AutoPlay}" />
                            <TextBlock Text="{Binding PlaylistPositionText}"
                                       Classes="muted"
                                       FontSize="11"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="目前播放項目 / 播放清單總數" />
                        </StackPanel>
                        <TextBlock IsVisible="{Binding IsRecentDock}"
                                   Text="最多 50 筆，重開仍可讀取"
                                   Classes="muted"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock IsVisible="{Binding IsStreamDock}"
                                   Text="網路串流最多 30 筆"
                                   Classes="muted"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="清除"
                                Command="{Binding ClearDockCommand}"
                                ToolTip.Tip="清除目前分頁內容" />
                    </Grid>

                    <!-- Playlist -->
                    <ListBox x:Name="PlaylistList"
                             Grid.Row="2"
                             Margin="4,0,4,8"
                             Classes="playlist"
                             IsVisible="{Binding IsPlaylistDock}"
                             ItemsSource="{Binding Playlist}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新增檔案…"
                                          Command="{Binding QueueMediaCommand}" />
                                <MenuItem Header="新增資料夾…"
                                          Command="{Binding QueueFolderCommand}" />
                                <MenuItem Header="新增網路串流…"
                                          Command="{Binding QueueNetworkUrlCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Button Classes="playlist-row"
                                        Classes.current="{Binding IsCurrent}"
                                        Classes.delete-selected="{Binding IsMarkedForDeletion}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectMediaCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="0,1"
                                        HorizontalAlignment="Stretch">
                                    <Button.ContextMenu>
                                        <ContextMenu Opening="OnPlaylistFileMenuOpening">
                                            <MenuItem Header="在檔案總管中顯示"
                                                      Click="OnRevealPlaylistFileClick" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Index}"
                                                   Classes="muted"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding !IsCurrent}" />
                                        <TextBlock Grid.Column="0"
                                                   Text="▶"
                                                   Foreground="{StaticResource AccentGlowBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   IsVisible="{Binding IsCurrent}" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Duration}"
                                                   Classes="muted"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   FontFeatures="tnum" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Recent (local + network) -->
                    <Grid Grid.Row="2" IsVisible="{Binding IsRecentDock}">
                        <TextBlock Text="尚無最近播放紀錄&#x0a;播放本機或網路媒體後會自動出現"
                                   Classes="muted"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="16"
                                   IsVisible="{Binding !HasRecentItems}" />
                        <ListBox Margin="4,0,4,8"
                                 Classes="playlist"
                                 IsVisible="{Binding HasRecentItems}"
                                 ItemsSource="{Binding RecentItems}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentPlayEntry">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                        <Button Classes="playlist-row"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayRecentCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="{Binding Subtitle}">
                                            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding KindLabel}"
                                                           Classes="muted"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                                <Binding Path="PlayedAtText" />
                                                                <Binding Path="Duration" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Format}"
                                                           Classes="muted"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Content="×"
                                                Width="28"
                                                Height="28"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="移除此筆"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveRecentCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Recent network streams only -->
                    <Grid Grid.Row="2" IsVisible="{Binding IsStreamDock}">
                        <TextBlock Text="尚無網路串流紀錄&#x0a;開啟網路串流後會自動記錄"
                                   Classes="muted"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="16"
                                   IsVisible="{Binding !HasRecentStreamItems}" />
                        <ListBox Margin="4,0,4,8"
                                 Classes="playlist"
                                 IsVisible="{Binding HasRecentStreamItems}"
                                 ItemsSource="{Binding RecentStreamItems}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RecentPlayEntry">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                        <Button Classes="playlist-row"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).PlayRecentStreamCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="{Binding SourceUrl}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SourceUrl}"
                                                               Classes="muted"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" FontSize="10">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                                <Binding Path="PlayedAtText" />
                                                                <Binding Path="KindLabel" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Format}"
                                                           Classes="muted"
                                                           FontSize="10"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="ghost"
                                                Content="×"
                                                Width="28"
                                                Height="28"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="移除此串流"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveRecentStreamCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== INFO BAR (PotPlayer-style) ===================== -->
        <Border Grid.Row="3" Classes="info-bar">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                <!-- Big time + duration (PotPlayer: huge white numbers) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding PositionText, FallbackValue='00:00'}"
                               Classes="big-time" />
                    <TextBlock Text="/" Classes="big-time-small" />
                    <TextBlock Text="{Binding DurationText, FallbackValue='00:00'}"
                               Classes="big-time-small" />
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Height="22" Margin="14,0,14,0"
                        Background="{StaticResource BorderSubtleBrush}" />

                <!-- Filename + codec info -->
                <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="1" MaxWidth="380">
                    <TextBlock Classes="info-filename"
                               Text="{Binding CurrentMedia.Title, FallbackValue='尚未載入'}" />
                    <TextBlock Classes="codec-label"
                               Text="{Binding StatusDetail, FallbackValue='MP3 · 192kbps · 48kHz'}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Spacer -->
                <Border Grid.Column="3" />

                <!-- VU meter (right side of info bar) -->
                <Border Grid.Column="4"
                        Background="{StaticResource VuDimBrush}"
                        CornerRadius="2"
                        Padding="2"
                        Margin="0,2,12,2"
                        VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding VuLevels}"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Double">
                                <Border Classes="vu-bar"
                                        Height="{Binding Converter={x:Static conv:VuHeightConverter.Instance}, ConverterParameter=22}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Codec chip cluster (MP4 / AVC1 / AAC) -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" Margin="0,0,4,0">
                    <Border Classes="format-tag" Background="#1A2A3A" BorderBrush="#2A4A6A">
                        <TextBlock Text="{Binding FormatTag}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGlowBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== YELLOW SEEK BAR ===================== -->
        <Border Grid.Row="4" Classes="seek-bar-container">
            <Slider Name="SeekSlider"
                    Classes="seek-yellow"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Progress, Mode=TwoWay}"
                    IsEnabled="{Binding HasPlayableMedia}"
                    ToolTip.Tip="拖曳或點擊時間軸跳轉"
                    KeyUp="OnSeekKeyUp" />
        </Border>

        <!-- ===================== COMPACT TRANSPORT (PotPlayer-style) ===================== -->
        <Grid Grid.Row="5" RowDefinitions="Auto,Auto">
            <!-- FS hot-zone -->
            <Border x:Name="HotZone"
                    Height="6"
                    Background="Transparent"
                    PointerEntered="OnHotZoneEntered" />

            <Border Grid.Row="1"
                    x:Name="ControlBar"
                    Classes="control-bar-compact"
                    IsVisible="{Binding IsControlBarVisible}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                    <!-- Left: stop / prev / play / next / ±10s -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="transport-compact"
                                Content="■"
                                ToolTip.Tip="停止 (S)"
                                Command="{Binding StopMediaCommand}" />
                        <Button Classes="transport-compact"
                                Content="⏮"
                                ToolTip.Tip="上一個"
                                Command="{Binding PlayPreviousCommand}" />
                        <Button Classes="play-main-compact"
                                Command="{Binding TogglePlayCommand}"
                                Content="{Binding IsPlaying, Converter={x:Static conv:PlayPauseGlyphConverter.Instance}}"
                                ToolTip.Tip="播放/暫停 (Space)" />
                        <Button Classes="transport-compact"
                                Content="⏭"
                                ToolTip.Tip="下一個"
                                Command="{Binding PlayNextCommand}" />
                        <Button Classes="transport-compact"
                                Content="−10"
                                FontSize="9.5"
                                ToolTip.Tip="倒退 10 秒"
                                Command="{Binding SeekRelativeCommand}"
                                CommandParameter="-10" />
                        <Button Classes="transport-compact"
                                Content="+10"
                                FontSize="9.5"
                                ToolTip.Tip="快轉 10 秒"
                                Command="{Binding SeekRelativeCommand}"
                                CommandParameter="10" />
                    </StackPanel>

                    <!-- Center spacer (seek bar lives in its own row above) -->
                    <Border Grid.Column="1" />

                    <!-- Right: mute / volume / playlist / FS / open / CC / LRC -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="transport-compact"
                                ToolTip.Tip="靜音 (M)"
                                Command="{Binding ToggleMuteCommand}">
                            <Panel>
                                <TextBlock Text="🔊" IsVisible="{Binding !IsMuted}" FontSize="12" />
                                <TextBlock Text="🔇" IsVisible="{Binding IsMuted}" FontSize="12" />
                            </Panel>
                        </Button>
                        <Slider Classes="volume-compact"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="音量" />
                        <Button Classes="transport-compact"
                                Content="☰"
                                ToolTip.Tip="播放清單 (P)"
                                Command="{Binding TogglePlaylistCommand}" />
                        <Button Classes="transport-compact"
                                Content="⛶"
                                ToolTip.Tip="全螢幕 (F)"
                                Command="{Binding ToggleFullscreenCommand}" />
                        <Button Classes="transport-compact"
                                ToolTip.Tip="Load dynamic lyrics (.lrc)"
                                Command="{Binding OpenLyricsCommand}">
                            <TextBlock Text="LRC" FontSize="9.5" FontWeight="Bold" />
                        </Button>
                        <!-- Subtitle button: visible only in video mode -->
                        <Button Classes="transport-compact"
                                IsVisible="{Binding IsVideoStage}"
                                ToolTip.Tip="{Binding HasSubtitle, Converter={x:Static conv:SubtitleTooltipConverter.Instance}}"
                                Command="{Binding OpenSubtitleCommand}">
                            <Panel>
                                <TextBlock Text="CC" FontSize="10" FontWeight="Bold"
                                           IsVisible="{Binding !HasSubtitle}"
                                           Opacity="0.5" />
                                <TextBlock Text="CC" FontSize="10" FontWeight="Bold"
                                           IsVisible="{Binding HasSubtitle}"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Panel>
                        </Button>
                        <Button Classes="transport-compact"
                                Content="📂"
                                ToolTip.Tip="開啟檔案 (Ctrl+O)"
                                Command="{Binding OpenMediaCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== STATUS ===================== -->
        <Border Grid.Row="6"
                Classes="status-bar"
                IsVisible="{Binding IsStatusBarVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="muted"
                           FontSize="11.5"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusDetail}"
                           Classes="muted"
                           FontSize="11.5"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
